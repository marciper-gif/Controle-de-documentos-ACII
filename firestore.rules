rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // MULTIEMPRESA (SaaS) — leia isto antes de mexer em qualquer regra.
    //
    // Todo documento de negócio carrega um campo `companyId`. Nenhuma
    // leitura ou escrita é permitida se o `companyId` do documento não
    // bater com o `companyId` da sessão que está pedindo. É essa
    // comparação — feita em toda regra abaixo — que impede um usuário da
    // Empresa A de ler ou escrever dado da Empresa B, mesmo que ele saiba
    // (ou adivinhe) o ID exato do documento.
    //
    // O login principal do app (CPF/matrícula + senha) é validado 100%
    // no cliente (src/lib/userManagement.ts) e NUNCA usa o Firebase Auth
    // diretamente — só quem entra com "Entrar com o Google" tem uma
    // sessão real. Por isso o app cria uma sessão anônima do Firebase
    // Auth como ponte (ensureAnonymousAuth, em src/config/firebase.ts) e
    // grava o vínculo usuário/empresa/papel/setor em auth_links/{uid}
    // (src/lib/authLink.ts) logo após qualquer login bem-sucedido.
    // Estas regras dependem desse vínculo para saber quem está pedindo
    // o quê — sem ele, `request.auth` existe mas não tem empresa nenhuma
    // (equivale a "sem acesso", nunca a "acesso indevido").
    // ─────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAuthLink() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/auth_links/$(request.auth.uid));
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/auth_links/$(request.auth.uid)).data;
    }

    function currentRole() {
      return hasAuthLink() ? currentProfile().role : null;
    }

    function currentUserId() {
      return hasAuthLink() ? currentProfile().userId : null;
    }

    function currentSectorId() {
      return hasAuthLink() ? currentProfile().sectorId : null;
    }

    // O "crachá" de empresa da sessão atual. Enquanto não existir
    // auth_link (antes do login terminar de vincular), isto é `null` —
    // e `resource.data.companyId == null` nunca é verdade para um
    // documento de negócio de verdade, então o efeito é "nega tudo",
    // nunca "libera tudo".
    function currentCompanyId() {
      return hasAuthLink() ? currentProfile().companyId : null;
    }

    function belongsToCurrentCompany() {
      return currentCompanyId() != null && resource.data.companyId == currentCompanyId();
    }

    function writeBelongsToCurrentCompany() {
      return currentCompanyId() != null && request.resource.data.companyId == currentCompanyId();
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    // "gestor" e "lider" têm o mesmo nível de gestão de setor no app hoje
    // (ver roleKey em App.tsx: currentUser.role === 'lider' ? 'gestor' : ...)
    function isGestor() {
      return currentRole() == 'gestor' || currentRole() == 'lider';
    }

    // ─────────────────────────────────────────────────────────────────
    // Fase 3 — "gestor de setor": admin mexe em tudo da empresa; gestor
    // só em documentos do PRÓPRIO setor (sectorId precisa bater com o
    // sectorId da sessão, gravado em auth_links no login — ver
    // src/lib/authLink.ts). `sectorId` é opcional em ATR/POP/IT (só
    // passou a existir nesta fase) — um documento antigo sem esse campo
    // fica temporariamente só editável por admin, até ser migrado
    // (nunca lido/vazado por engano: é "nega", não "libera", na dúvida).
    // ─────────────────────────────────────────────────────────────────
    function canManageSector(sectorId) {
      return isAdmin() || (isGestor() && currentSectorId() != null && currentSectorId() == sectorId);
    }

    // ─────────────────────────────────────────────────────────────────
    // companies: cadastro das empresas-cliente (tenants). Leitura aberta
    // a qualquer sessão autenticada (inclui a anônima) porque a tela de
    // login precisa listar as empresas ativas ANTES de saber a qual
    // empresa o usuário pertence — expõe só nome/id/logo/cor, nada
    // sensível. Criação/exclusão: nenhuma via cliente — continuam só
    // por script administrativo (Admin SDK, que ignora estas regras),
    // conforme decidido na Fase 3.
    //
    // Fase 4: admin da PRÓPRIA empresa pode atualizar o documento, mas
    // só pra subir logo/cor de marca — `name`, `status` e `id` nunca
    // mudam por aqui (continuam script-only). Sem essa trava, a mesma
    // abertura serviria pra um admin se "renomear" ou se reativar
    // sozinho caso um dia alguém marque a empresa como inativa.
    // ─────────────────────────────────────────────────────────────────
    match /companies/{companyIdParam} {
      allow read: if isAuthenticated();
      allow create, delete: if false;
      allow update: if isAdmin() && companyIdParam == currentCompanyId() &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.id == resource.data.id;
    }

    // ─────────────────────────────────────────────────────────────────
    // auth_links: cada sessão só enxerga e só grava o PRÓPRIO vínculo.
    // É assim que uma sessão anônima ou do Google se conecta à empresa,
    // usuário, papel e setor reais logo após o login.
    // ─────────────────────────────────────────────────────────────────
    match /auth_links/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────────────
    // login_index: espelho mínimo de `users`, só para o login funcionar
    // ANTES de existir auth_link (quando ainda não sabemos a empresa do
    // usuário pra restringir nada). Documento por ID DETERMINÍSTICO
    // ("{companyId}__{usernameLowerCase}"), nunca por consulta — ou
    // seja, só dá pra ler UM registro por vez, e só quem já sabe o
    // usuário E a empresa (dados públicos, não secretos: a tela de login
    // pede os dois). Guarda só o essencial pra validar a senha
    // (passwordHash, nunca a senha em texto puro, e o userId pra buscar
    // o resto do perfil). O resto do cadastro (papel, setor, dados
    // pessoais) mora só em `users`, que é protegido por companyId de
    // verdade (ver abaixo) — não em `login_index`.
    //
    // POR QUE ISSO É MELHOR QUE A REGRA ANTIGA (que liberava
    // `allow read` na coleção `users` inteira pra qualquer sessão
    // autenticada): antes, uma única consulta sem filtro (`getDocs` na
    // coleção) devolvia TODOS os usuários de TODAS as empresas de uma
    // vez. Com `get` por ID exato, um invasor só consegue ler um usuário
        // por vez, e só se já souber o nome de usuário — não dá mais pra
    // "baixar a lista inteira" num único pedido.
    //
    // LIMITAÇÃO HONESTA (documentando, não escondendo): isto reduz o
    // risco de vazamento em massa, mas não é uma solução perfeita — a
    // solução definitiva é mover a checagem de senha para dentro de uma
    // Cloud Function (o cliente nunca veria nenhum hash). Registrado
    // como recomendação de reforço antes de a Fase 3 trazer a segunda
    // empresa real para o sistema.
    // ─────────────────────────────────────────────────────────────────
    match /login_index/{loginKey} {
      allow get: if isAuthenticated();
      allow list: if false;
      // Mantido em sincronia pelo código que cria/edita conta ou senha
      // (src/lib/userManagement.ts). O próprio ID do documento precisa
      // bater com "{companyId}__{username}" do conteúdo gravado — isso
      // impede um admin/gestor da Empresa B de sobrescrever, mesmo por
      // acidente, o registro de login de um usuário da Empresa A.
      allow create, update: if isAuthenticated() &&
        loginKey == (request.resource.data.companyId + '__' + request.resource.data.username) &&
        (
          ((isAdmin() || isGestor()) && writeBelongsToCurrentCompany()) ||
          currentUserId() == request.resource.data.userId
        );
      allow delete: if (isAdmin() || isGestor()) && belongsToCurrentCompany();
    }

    // ─────────────────────────────────────────────────────────────────
    // Setores, ATRs, POPs, ITs, Funcionários, Documentos digitalizados:
    // leitura sempre pra qualquer papel da mesma empresa; `companyId`
    // nunca pode ser trocado numa atualização (impede "mudar de empresa"
    // um documento já existente). Quem pode ESCREVER varia por papel
    // (Fase 3, "papéis mínimos"):
    //   - sectors: só admin ("admin da empresa configura setores").
    //   - atrs/pops/its/guarded_documents: admin em qualquer setor,
    //     gestor só no PRÓPRIO setor (canManageSector) — "gestor de
    //     setor gerencia documentos do próprio setor".
    //   - employees: admin ou gestor, empresa inteira (sem trava de
    //     setor aqui — fora do escopo desta fase, fica pra revisão
    //     futura se fizer sentido apertar também).
    // ─────────────────────────────────────────────────────────────────
    match /sectors/{sectorId} {
      allow read: if isAuthenticated() && belongsToCurrentCompany();
      allow create: if isAdmin() && writeBelongsToCurrentCompany();
      allow update: if isAdmin() && belongsToCurrentCompany() &&
        request.resource.data.companyId == resource.data.companyId;
      allow delete: if isAdmin() && belongsToCurrentCompany();
    }

    match /pops/{popId} {
      allow read: if isAuthenticated() && belongsToCurrentCompany();
      allow create: if writeBelongsToCurrentCompany() && canManageSector(request.resource.data.sectorId);
      allow update: if belongsToCurrentCompany() &&
        request.resource.data.companyId == resource.data.companyId &&
        canManageSector(request.resource.data.sectorId) && canManageSector(resource.data.sectorId);
      allow delete: if belongsToCurrentCompany() && canManageSector(resource.data.sectorId);
    }

    match /atrs/{atrId} {
      allow read: if isAuthenticated() && belongsToCurrentCompany();
      allow create: if writeBelongsToCurrentCompany() && canManageSector(request.resource.data.sectorId);
      allow update: if belongsToCurrentCompany() &&
        request.resource.data.companyId == resource.data.companyId &&
        canManageSector(request.resource.data.sectorId) && canManageSector(resource.data.sectorId);
      allow delete: if belongsToCurrentCompany() && canManageSector(resource.data.sectorId);
    }

    match /its/{itId} {
      allow read: if isAuthenticated() && belongsToCurrentCompany();
      allow create: if writeBelongsToCurrentCompany() && canManageSector(request.resource.data.sectorId);
      allow update: if belongsToCurrentCompany() &&
        request.resource.data.companyId == resource.data.companyId &&
        canManageSector(request.resource.data.sectorId) && canManageSector(resource.data.sectorId);
      allow delete: if belongsToCurrentCompany() && canManageSector(resource.data.sectorId);
    }

    match /employees/{employeeId} {
      allow read: if isAuthenticated() && belongsToCurrentCompany();
      allow create: if (isAdmin() || isGestor()) && writeBelongsToCurrentCompany();
      allow update: if (isAdmin() || isGestor()) && belongsToCurrentCompany() &&
        request.resource.data.companyId == resource.data.companyId;
      allow delete: if (isAdmin() || isGestor()) && belongsToCurrentCompany();
    }

    // ─────────────────────────────────────────────────────────────────
    // users: contas de acesso. `get` (por ID exato) continua liberado
    // pra qualquer sessão autenticada — é o que permite o app buscar o
    // PRÓPRIO perfil completo logo depois de validar a senha via
    // `login_index`, antes de o auth_link existir. `list` (consulta que
    // devolve vários documentos de uma vez) exige empresa batendo —
    // impede alguém já logado numa empresa de listar usuários de outra.
    //
    // Escrita: admin OU gestor da empresa (gestor precisa continuar
    // criando a conta de acesso de um funcionário novo do próprio setor
    // — ver EmployeeManager.tsx — mesmo que a TELA dedicada de gestão de
    // usuários, na Fase 3, tenha ficado só pro admin — ver App.tsx,
    // botão "Senhas"). Qualquer usuário também pode mexer na PRÓPRIA
    // conta (troca de senha no primeiro acesso, por exemplo).
    // ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && belongsToCurrentCompany();
      allow create: if (isAdmin() || isGestor()) && writeBelongsToCurrentCompany();
      // O próprio dono da sessão pode atualizar a PRÓPRIA conta (troca de
      // senha, primeiro acesso), mas NUNCA o próprio `role` — sem essa
      // trava, qualquer colaborador logado poderia se autopromover a
      // admin com uma única escrita direta ao Firestore (bypassando a
      // tela). Achado ao revisar esta regra na Fase 3, corrigido aqui.
      allow update: if isAuthenticated() &&
        request.resource.data.companyId == resource.data.companyId &&
        (
          ((isAdmin() || isGestor()) && belongsToCurrentCompany()) ||
          (currentUserId() == userId && request.resource.data.role == resource.data.role)
        );
      allow delete: if (isAdmin() || isGestor()) && belongsToCurrentCompany();
    }

    // Permissões de perfis — um documento por empresa (ID = companyId).
    // Só admin da própria empresa define o que cada papel pode fazer.
    match /permissions/{permCompanyId} {
      allow read: if isAuthenticated() && permCompanyId == currentCompanyId();
      allow write: if isAdmin() && permCompanyId == currentCompanyId();
    }

    // Tipos de documento (Fase 2) — um documento por empresa
    // (ID = companyId), mesmo padrão de `permissions`. Só controla
    // apresentação (nome exibido / ativo-inativo dos 4 tipos padrão:
    // ATR, POP, IT, Digitalizado) — nunca a estrutura de dados em si.
    match /document_type_settings/{dtCompanyId} {
      allow read: if isAuthenticated() && dtCompanyId == currentCompanyId();
      allow write: if isAdmin() && dtCompanyId == currentCompanyId();
    }

    // Logs de auditoria do sistema: qualquer sessão autenticada pode
    // registrar um evento da própria empresa; só admin lê o histórico
    // completo, e só o da própria empresa.
    match /system_logs/{logId} {
      allow create: if isAuthenticated() &&
        (currentCompanyId() == null || writeBelongsToCurrentCompany());
      allow read: if isAdmin() && belongsToCurrentCompany();
      allow update, delete: if isAdmin() && belongsToCurrentCompany();
    }

    // ─────────────────────────────────────────────────────────────────
    // Módulo de guarda de documentos (guarda controlada por setor,
    // dentro da própria empresa). Leitura: admin da empresa, ou setor
    // dono do documento, ou setor listado em extraViewerSectorIds.
    // Criação: admin/gestor da empresa. Edição/eliminação: admin, ou
    // gestor do próprio setor do documento — sempre dentro da mesma
    // empresa.
    // ─────────────────────────────────────────────────────────────────
    match /guarded_documents/{docId} {
      allow read: if isAuthenticated() && belongsToCurrentCompany() && (
        isAdmin()
        || currentSectorId() == resource.data.sectorId
        || (resource.data.extraViewerSectorIds is list
            && currentSectorId() in resource.data.extraViewerSectorIds)
      );

      // Criação também trava no próprio setor do gestor (Fase 3) — antes
      // só update/delete tinham essa trava; a criação ficava mais aberta
      // que o próprio Storage (que já barrava o arquivo em si — ver
      // storage.rules), uma inconsistência que não fazia sentido manter.
      allow create: if writeBelongsToCurrentCompany() && canManageSector(request.resource.data.sectorId);

      allow update: if belongsToCurrentCompany() &&
        request.resource.data.companyId == resource.data.companyId &&
        canManageSector(request.resource.data.sectorId) && canManageSector(resource.data.sectorId);

      allow delete: if belongsToCurrentCompany() && canManageSector(resource.data.sectorId);
    }
  }
}
