rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // O login principal do app (CPF/matrícula + senha) é validado pela
    // Cloud Function `login` (functions/index.js, Admin SDK — ignora
    // estas regras), NUNCA no cliente. O app cria uma sessão anônima do
    // Firebase Auth como ponte (ensureAnonymousAuth, em
    // src/config/firebase.ts) ANTES do login, só pra ter um
    // request.auth.uid; a própria Cloud Function grava o vínculo
    // usuário/papel/setor em auth_links/{uid} depois de validar a senha
    // no servidor. Quem entra com "Entrar com o Google" passa pela
    // Cloud Function `linkGoogleUser`, mesmo motivo. Estas regras
    // dependem desse vínculo para saber quem está pedindo o quê — sem
    // ele, `request.auth` existe mas não tem papel nenhum. O CLIENTE
    // NUNCA escreve auth_links diretamente (ver a regra logo abaixo) —
    // só essas duas Cloud Functions podem.
    // ─────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAuthLink() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/auth_links/$(request.auth.uid));
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/auth_links/$(request.auth.uid)).data;
    }

    function currentRole() {
      return hasAuthLink() ? currentProfile().role : null;
    }

    function currentUserId() {
      return hasAuthLink() ? currentProfile().userId : null;
    }

    function currentSectorId() {
      return hasAuthLink() ? currentProfile().sectorId : null;
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    // "gestor" e "lider" têm o mesmo nível de gestão de setor no app hoje
    // (ver roleKey em App.tsx: currentUser.role === 'lider' ? 'gestor' : ...)
    function isGestor() {
      return currentRole() == 'gestor' || currentRole() == 'lider';
    }

    // ─────────────────────────────────────────────────────────────────
    // auth_links: cada sessão só enxerga o PRÓPRIO vínculo, e não pode
    // mais escrevê-lo diretamente. Antes disso, uma sessão anônima
    // (criada automaticamente pra QUALQUER visitante, antes até de
    // logar) podia gravar auth_links/{uid} = {role: 'admin'} direto pelo
    // SDK do cliente e virar administrador sem nunca ter feito login —
    // a Cloud Function syncAuthLinkClaims (functions/index.js) espelhava
    // esse papel forjado pros Custom Claims cegamente. Agora só as
    // Cloud Functions login/linkGoogleUser (Admin SDK, ignora estas
    // regras) gravam este documento, depois de validar usuário/senha ou
    // a sessão do Google no servidor.
    // ─────────────────────────────────────────────────────────────────
    match /auth_links/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // login_attempts: contador de tentativas de login (força bruta) —
    // só a Cloud Function login o lê/grava (Admin SDK, ignora regras).
    match /login_attempts/{attemptId} {
      allow read, write: if false;
    }

    // Setores: leitura para qualquer sessão autenticada (inclui a anônima
    // usada pelo login por CPF/senha — a tela de login e o app em geral
    // precisam da lista de setores antes mesmo de existir um auth_link).
    // Escrita restrita a quem gerencia a estrutura organizacional.
    match /sectors/{sectorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    // Documentos do sistema (POPs, ATRs, ITs)
    match /pops/{popId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    match /atrs/{atrId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    match /its/{itId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    // Funcionários
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    // Usuários (contas de acesso — hash de senha, papel, status).
    // ANTES: legível por qualquer sessão autenticada, inclusive a
    // anônima criada automaticamente pra todo visitante — ou seja,
    // qualquer pessoa que abrisse o site conseguia ler CPF e hash de
    // senha de todo mundo. O login agora é validado inteiramente na
    // Cloud Function `login` (Admin SDK, ignora estas regras), então o
    // cliente não precisa mais ler esta coleção pra logar — só admin/
    // gestor (telas de gestão) ou o próprio dono do registro.
    //
    // Escrita: admin/gestor grava qualquer campo (gestão de contas). O
    // próprio usuário só pode alterar o PRÓPRIO documento, e nunca os
    // campos que definem seu nível de acesso (role, employeeId, status,
    // accountStatus) — sem isso, qualquer colaborador logado poderia
    // simplesmente gravar role:"admin" no próprio registro pelo SDK do
    // cliente. Trocar a própria senha passa pela Cloud Function
    // `setPassword` (Admin SDK) e não escreve mais aqui direto.
    match /users/{userId} {
      allow read: if isAdmin() || isGestor() || currentUserId() == userId;
      allow create: if isAdmin() || isGestor();
      allow update: if isAdmin() || isGestor() || (
        currentUserId() == userId &&
        request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('employeeId', null) == resource.data.get('employeeId', null) &&
        request.resource.data.get('status', null) == resource.data.get('status', null) &&
        request.resource.data.get('accountStatus', null) == resource.data.get('accountStatus', null)
      );
      allow delete: if isAdmin();
    }

    // Permissões de perfis — só admin define o que cada papel pode fazer.
    match /permissions/{permId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Logs de auditoria do sistema: qualquer sessão autenticada pode
    // registrar um evento; só admin lê o histórico completo.
    match /system_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────
    // Módulo de guarda de documentos (guarda controlada por setor).
    // Leitura: admin, ou setor dono do documento, ou setor listado em
    // extraViewerSectorIds. Criação: admin/gestor. Edição/eliminação:
    // admin, ou gestor do próprio setor do documento.
    // ─────────────────────────────────────────────────────────────────
    match /guarded_documents/{docId} {
      allow read: if isAdmin()
        || currentSectorId() == resource.data.sectorId
        || (resource.data.extraViewerSectorIds is list
            && currentSectorId() in resource.data.extraViewerSectorIds);

      allow create: if isAdmin() || isGestor();

      allow update, delete: if isAdmin()
        || (isGestor() && currentSectorId() == resource.data.sectorId);
    }
  }
}
