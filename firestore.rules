rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Safety Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc().role == 'admin';
    }

    function isGestorOrLider() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserDoc().role == 'gestor' || getUserDoc().role == 'lider');
    }

    // 3. Sectors Collection
    match /sectors/{sectorId} {
      allow read: if isSignedIn() && isValidId(sectorId);
      allow write: if isAdmin() && isValidId(sectorId);
    }

    // 4. Employees Collection
    match /employees/{employeeId} {
      allow read: if isSignedIn() && isValidId(employeeId);
      allow write: if (isAdmin() || isGestorOrLider()) && isValidId(employeeId);
    }

    // 5. ATRs Collection
    match /atrs/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
      allow write: if (isAdmin() || isGestorOrLider()) && isValidId(docId);
    }

    // 6. POPs Collection
    match /pops/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
      allow write: if (isAdmin() || isGestorOrLider()) && isValidId(docId);
    }

    // 7. ITs Collection
    match /its/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
      allow write: if (isAdmin() || isGestorOrLider()) && isValidId(docId);
    }

    // 8. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // 9. Permissions Matrix
    match /permissions/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
      allow write: if isAdmin() && isValidId(docId);
    }
  }
}
