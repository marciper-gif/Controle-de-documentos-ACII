rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // O login principal do app (CPF/matrícula + senha) é reconferido no
    // servidor por /api/login.ts (Firebase Admin SDK) — que só então
    // emite um token de sessão real do Firebase Auth, já com "role" e
    // "sectorId" embutidos como custom claims. Login por Google usa
    // /api/set-claims.ts pra ganhar as mesmas claims. Por isso dá pra
    // confiar direto em request.auth.token.role / .sectorId aqui, sem
    // nenhuma leitura extra ao Firestore. Ver src/lib/authBackend.ts.
    // ─────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentRole() {
      return isAuthenticated() ? request.auth.token.role : null;
    }

    function currentSectorId() {
      return isAuthenticated() ? request.auth.token.sectorId : null;
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    // "gestor" e "lider" têm o mesmo nível de gestão de setor no app hoje
    // (ver roleKey em App.tsx: currentUser.role === 'lider' ? 'gestor' : ...)
    function isGestor() {
      return currentRole() == 'gestor' || currentRole() == 'lider';
    }

    // Setores: leitura para qualquer sessão autenticada. Escrita restrita
    // a quem gerencia a estrutura organizacional.
    match /sectors/{sectorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    // Documentos do sistema (POPs, ATRs, ITs)
    match /pops/{popId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    match /atrs/{atrId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    match /its/{itId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    // Funcionários
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor();
    }

    // Usuários (contas de acesso, incluindo hash de senha). Só é lida
    // hoje pelo /api/login.ts via Admin SDK (que ignora estas regras) e
    // pela UI já autenticada — então dá pra restringir de verdade,
    // diferente da versão anterior que precisava manter isso aberto pra
    // sessão anônima. Escrita: admin/gestor (gestão de contas) ou o
    // próprio usuário dono da sessão (troca de senha).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGestor() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Permissões de perfis — só admin define o que cada papel pode fazer.
    match /permissions/{permId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Logs de auditoria do sistema: qualquer sessão autenticada pode
    // registrar um evento; só admin lê o histórico completo.
    match /system_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────
    // Módulo de guarda de documentos (guarda controlada por setor).
    // Leitura: admin, ou setor dono do documento, ou setor listado em
    // extraViewerSectorIds. Criação: admin/gestor. Edição/eliminação:
    // admin, ou gestor do próprio setor do documento.
    // ─────────────────────────────────────────────────────────────────
    match /guarded_documents/{docId} {
      allow read: if isAdmin()
        || currentSectorId() == resource.data.sectorId
        || (resource.data.extraViewerSectorIds is list
            && currentSectorId() in resource.data.extraViewerSectorIds);

      allow create: if isAdmin() || isGestor();

      allow update, delete: if isAdmin()
        || (isGestor() && currentSectorId() == resource.data.sectorId);
    }
  }
}
