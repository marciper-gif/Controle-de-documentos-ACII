rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // O login principal do app (CPF/matrícula + senha) é validado pela
    // Cloud Function `login` (functions/index.js, Admin SDK — ignora
    // estas regras), NUNCA no cliente. O app cria uma sessão anônima do
    // Firebase Auth como ponte (ensureAnonymousAuth, em
    // src/config/firebase.ts) ANTES do login, só pra ter um
    // request.auth.uid; a própria Cloud Function grava o vínculo
    // usuário/papel/setor/EMPRESA em auth_links/{uid} depois de validar a
    // senha no servidor. Quem entra com "Entrar com o Google" passa pela
    // Cloud Function `linkGoogleUser`, mesmo motivo. Estas regras
    // dependem desse vínculo para saber quem está pedindo o quê — sem
    // ele, `request.auth` existe mas não tem papel nem empresa nenhuma. O
    // CLIENTE NUNCA escreve auth_links diretamente (ver a regra logo
    // abaixo) — só essas duas Cloud Functions podem.
    // ─────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAuthLink() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/auth_links/$(request.auth.uid));
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/auth_links/$(request.auth.uid)).data;
    }

    function currentRole() {
      return hasAuthLink() ? currentProfile().role : null;
    }

    function currentUserId() {
      return hasAuthLink() ? currentProfile().userId : null;
    }

    function currentSectorId() {
      return hasAuthLink() ? currentProfile().sectorId : null;
    }

    // ─────────────────────────────────────────────────────────────────
    // Multiempresa (Fase 1). companyId da SESSÃO vem de auth_links, nunca
    // de um campo que o próprio request esteja mandando — senão bastaria
    // qualquer cliente mandar o companyId que quisesse. Documento sem
    // auth_link (sessão anônima pré-login) não tem empresa nenhuma:
    // currentCompanyId() vira null, e nenhum documento real tem
    // companyId=null (a migração garante isso — ver
    // functions/migrate-add-company-id.js), então toda comparação abaixo
    // fecha o acesso por padrão nesse estado, em vez de abrir.
    // ─────────────────────────────────────────────────────────────────
    function currentCompanyId() {
      return hasAuthLink() ? currentProfile().companyId : null;
    }

    function isSameCompany(companyId) {
      return isAuthenticated() && currentCompanyId() != null && companyId == currentCompanyId();
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    // "gestor" e "lider" têm o mesmo nível de gestão de setor no app hoje
    // (ver roleKey em App.tsx: currentUser.role === 'lider' ? 'gestor' : ...)
    function isGestor() {
      return currentRole() == 'gestor' || currentRole() == 'lider';
    }

    // ─────────────────────────────────────────────────────────────────
    // Gestor de setor — portado da branch claude/acii-saas-multitenant-
    // fxrohc. ANTES: qualquer gestor da empresa podia criar/editar/apagar
    // POP, ATR, IT ou documento guardado de QUALQUER setor da empresa —
    // as regras só checavam isAdmin()/isGestor(), nunca o setor. Admin
    // continua mexendo em tudo da empresa; gestor só no PRÓPRIO setor.
    //
    // Duas variantes, porque os dados guardam o setor de duas formas
    // diferentes nesta base de código (não uniformizado ainda):
    //   - guarded_documents.sectorId é o ID de verdade (SectorData.id) —
    //     o mesmo formato de auth_links.sectorId, então compara direto.
    //   - ATR/POP/IT.sector é o NOME de exibição do setor (tipo "RH"),
    //     não o ID — herdado de antes de existir multiempresa. Por isso
    //     canManageSectorByName resolve o NOME do setor do gestor (via
    //     get() em sectors/{currentSectorId()}) antes de comparar. Um
    //     `get()` a mais por checagem, dentro do limite de leituras por
    //     avaliação de regra do Firestore.
    // ─────────────────────────────────────────────────────────────────
    function canManageSectorId(sectorId) {
      return isAdmin() || (isGestor() && currentSectorId() != null && currentSectorId() == sectorId);
    }

    function currentSectorName() {
      return (currentSectorId() != null && exists(/databases/$(database)/documents/sectors/$(currentSectorId())))
        ? get(/databases/$(database)/documents/sectors/$(currentSectorId())).data.name
        : null;
    }

    function canManageSectorByName(sectorName) {
      return isAdmin() || (isGestor() && currentSectorName() != null && currentSectorName() == sectorName);
    }

    // ─────────────────────────────────────────────────────────────────
    // auth_links: cada sessão só enxerga o PRÓPRIO vínculo, e não pode
    // mais escrevê-lo diretamente. Antes disso, uma sessão anônima
    // (criada automaticamente pra QUALQUER visitante, antes até de
    // logar) podia gravar auth_links/{uid} = {role: 'admin'} direto pelo
    // SDK do cliente e virar administrador sem nunca ter feito login —
    // a Cloud Function syncAuthLinkClaims (functions/index.js) espelhava
    // esse papel forjado pros Custom Claims cegamente. Agora só as
    // Cloud Functions login/linkGoogleUser (Admin SDK, ignora estas
    // regras) gravam este documento, depois de validar usuário/senha ou
    // a sessão do Google no servidor.
    // ─────────────────────────────────────────────────────────────────
    match /auth_links/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // login_attempts: contador de tentativas de login (força bruta) —
    // só a Cloud Function login o lê/grava (Admin SDK, ignora regras).
    match /login_attempts/{attemptId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────────
    // companies: registro de cada empresa (tenant) do sistema. Leitura só
    // da PRÓPRIA empresa (ninguém precisa enxergar o nome/logo de outro
    // cliente). CRIAR uma empresa nova continua um processo manual/Admin
    // SDK (a Fase 3 é que traz o fluxo de onboarding). ATUALIZAR: admin
    // da própria empresa pode editar as configurações dela (Fase 2 —
    // documentTypes; Fase 4 — logo/cor), sempre sem trocar o próprio `id`
    // nem migrar o documento pra outra empresa. Nunca DELETAR pelo
    // cliente — apagar uma empresa é decisão fora do escopo de um clique
    // de admin.
    // ─────────────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isSameCompany(companyId);
      allow create, delete: if false;
      allow update: if isSameCompany(companyId) && isAdmin() &&
        request.resource.data.id == companyId;
    }

    // Setores: leitura restrita à PRÓPRIA empresa — mudou na Fase 1. Antes
    // era liberado pra qualquer sessão autenticada, inclusive a anônima
    // pré-login, porque a tela de login precisava da lista de setores
    // antes de existir um auth_link. Isso não é mais compatível com
    // isolamento entre empresas (a sessão anônima de QUALQUER visitante
    // conseguiria listar os setores de QUALQUER empresa). A tela de login
    // hoje não depende mais disso (ver App.tsx — os hooks de estado só
    // assinam depois do login). Escrita restrita a quem gerencia a
    // estrutura organizacional, da própria empresa.
    match /sectors/{sectorId} {
      allow read: if isSameCompany(resource.data.companyId);
      allow create: if isSameCompany(request.resource.data.companyId) && (isAdmin() || isGestor());
      allow update, delete: if isSameCompany(resource.data.companyId) && (isAdmin() || isGestor());
    }

    // Documentos do sistema (POPs, ATRs, ITs) — mesmo padrão de isolamento
    // entre empresas, mais a restrição de setor do gestor (ver
    // canManageSectorByName acima). Update trava o setor NOS DOIS lados
    // (o valor novo E o valor antigo) — impede um gestor "levar" um
    // documento do próprio setor pra outro setor que ele não gerencia.
    match /pops/{popId} {
      allow read: if isSameCompany(resource.data.companyId);
      allow create: if isSameCompany(request.resource.data.companyId) &&
        canManageSectorByName(request.resource.data.get('sector', null));
      allow update: if isSameCompany(resource.data.companyId) &&
        canManageSectorByName(request.resource.data.get('sector', null)) &&
        canManageSectorByName(resource.data.get('sector', null));
      allow delete: if isSameCompany(resource.data.companyId) &&
        canManageSectorByName(resource.data.get('sector', null));
    }

    match /atrs/{atrId} {
      allow read: if isSameCompany(resource.data.companyId);
      allow create: if isSameCompany(request.resource.data.companyId) &&
        canManageSectorByName(request.resource.data.get('sector', null));
      allow update: if isSameCompany(resource.data.companyId) &&
        canManageSectorByName(request.resource.data.get('sector', null)) &&
        canManageSectorByName(resource.data.get('sector', null));
      allow delete: if isSameCompany(resource.data.companyId) &&
        canManageSectorByName(resource.data.get('sector', null));
    }

    match /its/{itId} {
      allow read: if isSameCompany(resource.data.companyId);
      allow create: if isSameCompany(request.resource.data.companyId) &&
        canManageSectorByName(request.resource.data.get('sector', null));
      allow update: if isSameCompany(resource.data.companyId) &&
        canManageSectorByName(request.resource.data.get('sector', null)) &&
        canManageSectorByName(resource.data.get('sector', null));
      allow delete: if isSameCompany(resource.data.companyId) &&
        canManageSectorByName(resource.data.get('sector', null));
    }

    // Funcionários
    match /employees/{employeeId} {
      allow read: if isSameCompany(resource.data.companyId);
      allow create: if isSameCompany(request.resource.data.companyId) && (isAdmin() || isGestor());
      allow update, delete: if isSameCompany(resource.data.companyId) && (isAdmin() || isGestor());
    }

    // Usuários (contas de acesso — hash de senha, papel, status, empresa).
    // ANTES: legível por qualquer sessão autenticada, inclusive a
    // anônima criada automaticamente pra todo visitante — ou seja,
    // qualquer pessoa que abrisse o site conseguia ler CPF e hash de
    // senha de todo mundo. O login agora é validado inteiramente na
    // Cloud Function `login` (Admin SDK, ignora estas regras), então o
    // cliente não precisa mais ler esta coleção pra logar — só admin/
    // gestor (telas de gestão) da MESMA empresa, ou o próprio dono do
    // registro.
    //
    // Escrita: admin/gestor da mesma empresa grava qualquer campo (gestão
    // de contas), sem poder criar/mudar um usuário para OUTRA empresa. O
    // próprio usuário só pode alterar o PRÓPRIO documento, e nunca os
    // campos que definem seu nível de acesso (role, employeeId, status,
    // accountStatus, companyId) — sem isso, qualquer colaborador logado
    // poderia gravar role:"admin" (ou companyId de outra empresa!) no
    // próprio registro pelo SDK do cliente. Trocar a própria senha passa
    // pela Cloud Function `setPassword` (Admin SDK) e não escreve mais
    // aqui direto.
    match /users/{userId} {
      allow read: if isSameCompany(resource.data.companyId) && (isAdmin() || isGestor() || currentUserId() == userId);
      allow create: if isSameCompany(request.resource.data.companyId) && (isAdmin() || isGestor());
      allow update: if (
        isSameCompany(resource.data.companyId) &&
        (isAdmin() || isGestor()) &&
        isSameCompany(request.resource.data.companyId)
      ) || (
        currentUserId() == userId &&
        request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('employeeId', null) == resource.data.get('employeeId', null) &&
        request.resource.data.get('status', null) == resource.data.get('status', null) &&
        request.resource.data.get('accountStatus', null) == resource.data.get('accountStatus', null) &&
        request.resource.data.get('companyId', null) == resource.data.get('companyId', null)
      );
      allow delete: if isSameCompany(resource.data.companyId) && isAdmin();
    }

    // Permissões de perfis — um documento POR EMPRESA desde a Fase 1 (era
    // um único permissions/default global antes; o ID do documento agora
    // É o companyId — ver src/lib/firebaseSync.ts, dbSavePermissions). Só
    // admin da própria empresa define o que cada papel pode fazer nela.
    match /permissions/{companyId} {
      allow read: if isSameCompany(companyId);
      allow write: if isSameCompany(companyId) && isAdmin();
    }

    // Logs de auditoria do sistema: qualquer sessão autenticada da mesma
    // empresa pode registrar um evento; só admin dessa empresa lê o
    // histórico completo.
    match /system_logs/{logId} {
      allow create: if isSameCompany(request.resource.data.companyId);
      allow read: if isSameCompany(resource.data.companyId) && isAdmin();
      allow update, delete: if isSameCompany(resource.data.companyId) && isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────
    // Módulo de guarda de documentos (guarda controlada por setor, dentro
    // da própria empresa). Leitura: admin da empresa, ou setor dono do
    // documento, ou setor listado em extraViewerSectorIds — sempre dentro
    // da mesma empresa. Criação/edição/eliminação: admin, ou gestor do
    // próprio setor do documento, sempre dentro da mesma empresa.
    // ─────────────────────────────────────────────────────────────────
    match /guarded_documents/{docId} {
      allow read: if isSameCompany(resource.data.companyId) && (
        isAdmin()
        || currentSectorId() == resource.data.sectorId
        || (resource.data.extraViewerSectorIds is list
            && currentSectorId() in resource.data.extraViewerSectorIds)
      );

      // Criação agora também trava no próprio setor do gestor — antes só
      // update/delete tinham essa trava (mesma inconsistência corrigida
      // na fxrohc: a criação ficava mais aberta que a própria edição).
      allow create: if isSameCompany(request.resource.data.companyId) &&
        canManageSectorId(request.resource.data.get('sectorId', null));

      allow update, delete: if isSameCompany(resource.data.companyId) &&
        canManageSectorId(resource.data.get('sectorId', null));
    }
  }
}
