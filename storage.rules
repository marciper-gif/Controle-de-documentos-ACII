rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────
    // HISTÓRICO: a primeira versão destas regras lia papel/setor via
    // "cross-service rules" (firestore.get() direto no auth_links/{uid}
    // do Firestore). Isso NUNCA funcionou neste projeto — o Firebase só
    // suporta cross-service rules contra o banco Firestore "(default)",
    // e este projeto usa um banco NOMEADO
    // (ai-studio-aciicontroledodo-8a9badc3-1faa-4b52-9783-49cb0814c900).
    // Toda checagem de isAdmin()/isGestor() falhava sempre, mesmo pra
    // admin de verdade — bug reproduzido e diagnosticado em produção.
    //
    // Solução: uma Cloud Function (functions/index.js,
    // syncAuthLinkClaims) espelha auth_links/{uid} (role, sectorId) em
    // Custom Claims do Firebase Auth sempre que esse documento muda.
    // Custom claims vêm DENTRO do token (request.auth.token), então o
    // Storage lê sem nenhuma consulta cross-service — problema resolvido
    // na raiz, não contornado.
    // ─────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentRole() {
      return isAuthenticated() ? request.auth.token.role : null;
    }

    function currentSectorId() {
      return isAuthenticated() ? request.auth.token.sectorId : null;
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    function isGestor() {
      return currentRole() == 'gestor' || currentRole() == 'lider';
    }

    // Validação server-side das restrições de upload do item 2 da
    // especificação (o modal de envio, item 4.3, também valida no
    // cliente — isto é só uma segunda barreira, defesa em profundidade).
    function isValidDocumentUpload() {
      return request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType.matches(
          'application/pdf'
          + '|application/msword'
          + '|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document'
          + '|application/vnd\\.ms-excel'
          + '|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet'
          + '|image/jpeg'
          + '|image/png'
        );
    }

    // documentos/{sectorId}/{documentId}/v{version}_{fileName}
    match /documentos/{sectorId}/{documentId}/{fileName} {
      // NOTA: o campo extraViewerSectorIds (setores extras com permissão
      // de visualização de um documento específico, item 5/6 da
      // especificação) NÃO é checado aqui — ele vive em
      // guarded_documents/{documentId} no Firestore, e checá-lo exigiria
      // de novo uma consulta cross-service (mesma limitação do banco
      // nomeado acima). Continua funcionando normalmente na TELA (o
      // Firestore libera a leitura da metadata pros setores extras
      // normalmente), mas o arquivo em si no Storage só é liberado pro
      // setor dono do documento ou admin. TODO: se isso virar bloqueio
      // real no uso, resolver com uma Cloud Function callable que gera
      // uma URL assinada de download após checar o Firestore no servidor
      // (sem as limitações do storage.rules).
      allow read: if isAuthenticated() && (isAdmin() || currentSectorId() == sectorId);

      // Upload/nova versão: admin ou gestor do próprio setor da pasta.
      // TODO (etapa 9 da especificação): incluir aqui também quem tiver
      // canUploadDocuments == true no perfil — precisa entrar nos custom
      // claims também (hoje só role/sectorId são espelhados).
      allow create, update: if isAuthenticated() &&
        (isAdmin() || (isGestor() && currentSectorId() == sectorId)) &&
        isValidDocumentUpload();

      // Exclusão física do arquivo: ninguém, por enquanto. "Marcar para
      // eliminação" (item 5 da especificação) só muda o status no
      // Firestore — a exclusão física sempre foi manual/separada. Sem
      // cross-service pra confirmar admin com segurança aqui, é mais
      // seguro fechar por completo até existir uma necessidade real.
      allow delete: if false;
    }

    // Qualquer outro caminho no bucket: fechado por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
