rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────
    // O papel e o setor da sessão vêm como custom claims no token do
    // Firebase Auth (request.auth.token.role / .sectorId), emitidas por
    // /api/login.ts e /api/set-claims.ts — ver src/lib/authBackend.ts e
    // firestore.rules para o desenho completo. Isso evita qualquer
    // leitura ao Firestore só pra saber quem está pedindo o quê; a única
    // leitura cross-service que ainda precisamos (firestore.get) é pra
    // checar extraViewerSectorIds do próprio documento, quando o setor
    // da sessão não bate com o dono da pasta.
    // ─────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentRole() {
      return isAuthenticated() ? request.auth.token.role : null;
    }

    function currentSectorId() {
      return isAuthenticated() ? request.auth.token.sectorId : null;
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    function isGestor() {
      return currentRole() == 'gestor' || currentRole() == 'lider';
    }

    // Setores extras com permissão de visualização, lidos do próprio
    // documento em guarded_documents/{documentId}. O caminho do banco
    // precisa vir por extenso, incluindo o nome do banco (não é o
    // "(default)" — este projeto usa um Firestore nomeado, ver
    // firestoreDatabaseId em firebase-applet-config.json). Se o banco
    // for recriado/renomeado, atualizar este ID.
    function docExtraViewerSectors(documentId) {
      return firestore.get(/databases/ai-studio-aciicontroledodo-8a9badc3-1faa-4b52-9783-49cb0814c900/documents/guarded_documents/$(documentId)).data.extraViewerSectorIds;
    }

    // Validação server-side das restrições de upload do item 2 da
    // especificação (o modal de envio, item 4.3, também valida no
    // cliente — isto é só uma segunda barreira, defesa em profundidade).
    function isValidDocumentUpload() {
      return request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType.matches(
          'application/pdf'
          + '|application/msword'
          + '|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document'
          + '|application/vnd\\.ms-excel'
          + '|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet'
          + '|image/jpeg'
          + '|image/png'
        );
    }

    // documentos/{sectorId}/{documentId}/v{version}_{fileName}
    match /documentos/{sectorId}/{documentId}/{fileName} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        currentSectorId() == sectorId ||
        (docExtraViewerSectors(documentId) is list && currentSectorId() in docExtraViewerSectors(documentId))
      );

      // Upload/nova versão: admin ou gestor do próprio setor da pasta.
      // TODO (etapa 9 da especificação): incluir aqui também quem tiver
      // canUploadDocuments == true no perfil, quando ProfilePermissions
      // for estendido e essa claim adicionada ao token em /api/login.ts.
      allow create, update: if isAuthenticated() &&
        (isAdmin() || (isGestor() && currentSectorId() == sectorId)) &&
        isValidDocumentUpload();

      // Exclusão física do arquivo: só admin. "Marcar para eliminação"
      // (item 5 da especificação) só muda o status no Firestore — não
      // apaga o arquivo do Storage automaticamente.
      allow delete: if isAdmin();
    }

    // Qualquer outro caminho no bucket: fechado por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
