rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────
    // IMPORTANTE — limitação conhecida deste projeto: o ideal seria
    // consultar o Firestore por dentro das Storage Rules (regras
    // "cross-service", ver auth_links/{uid} em firestore.rules) pra
    // checar o setor de quem está pedindo o arquivo. Isso exige uma
    // permissão extra de IAM entre Storage e Firestore que este projeto
    // (política de organização do Google Cloud) não deixa conceder —
    // mesma restrição que bloqueia gerar chave de serviço. Por isso,
    // aqui só exigimos "estar autenticado" (sessão anônima-ponte ou
    // Google — ver src/lib/authLink.ts), sem checar setor.
    //
    // Isso é uma redução real de segurança SÓ para o arquivo bruto: pra
    // alguém baixar um arquivo por fora do app, precisaria primeiro
    // descobrir o caminho exato (documentos/{sectorId}/{documentId}/
    // {fileName}) — e essa informação (metadados do documento) SÓ é
    // exposta pela consulta ao Firestore em guarded_documents, que essa
    // sim aplica o controle por setor corretamente (ver firestore.rules).
    // Ou seja: quem não tem acesso ao registro do documento no Firestore
    // não descobre o caminho do arquivo pela UI normal do app.
    // ─────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Validação server-side das restrições de upload do item 2 da
    // especificação (o modal de envio, item 4.3, também valida no
    // cliente — isto é só uma segunda barreira, defesa em profundidade).
    function isValidDocumentUpload() {
      return request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType.matches(
          'application/pdf'
          + '|application/msword'
          + '|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document'
          + '|application/vnd\\.ms-excel'
          + '|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet'
          + '|image/jpeg'
          + '|image/png'
        );
    }

    // documentos/{sectorId}/{documentId}/v{version}_{fileName}
    match /documentos/{sectorId}/{documentId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidDocumentUpload();
      allow delete: if isAuthenticated();
    }

    // Qualquer outro caminho no bucket: fechado por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
